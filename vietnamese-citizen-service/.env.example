# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/vietnamese_citizen
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Liquibase Configuration
SPRING_LIQUIBASE_ENABLED=true
SPRING_LIQUIBASE_CHANGELOG=classpath:/db/changelog/changelog.yaml
SPRING_LIQUIBASE_CONTEXTS=dev

# Application Configuration
SPRING_APPLICATION_NAME=vietnamese-citizen-service

# JPA/Hibernate Configuration (Optional - nếu anh dùng JPA)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Loki
LOKI_URL=http://host.docker.internal:3100
LOKI_TENANT_ID=vietnamese-citizen-service
LOG_ROOT_LEVEL=INFO

# Server
SERVER_PORT=8083

# Springdoc
SPRINGDOC_ENABLED=true
SHOW_ACTUATOR=true

# =====================================================
# PARTITION MAINTENANCE
# =====================================================
# Bật/tắt job tự động tạo partition
PARTITION_MAINTENANCE_ENABLED=true

# Cron: phút 59 của mỗi giờ (BẮT BUỘC ngoặc kép vì có khoảng trắng)
PARTITION_MAINTENANCE_CRON="0 59 * * * *"

# Số giờ tạo trước (1 = đúng giờ kế tiếp, 2 = chống lỡ nhịp)
PARTITION_MAINTENANCE_NUM_INTERVALS=1

# Danh sách bảng cần duy trì partition (phân tách bằng dấu phẩy)
PARTITION_MAINTENANCE_TABLES=citizen,address

# Bật endpoint POST /internal/partitions/maintain (chỉ nên true ở dev)
PARTITION_MAINTENANCE_EXPOSE_ENDPOINT=true

# Province
APP_PROVINCE_API_URL=http://host.docker.internal:8082
SEEDER_BATCH_SIZE=10000
SEEDER_BATCH_ENABLED=false
